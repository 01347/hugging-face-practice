        "from transformers import pipeline\n",
        "\n",
        "gen = pipeline(\"text-generation\", model=\"gpt2\")\n",
        "\n",
        "out = gen(\n",
        "    \"I'm very happy to study here\",\n",
        "    max_length=20,\n",
        "    num_return_sequences=2\n",
        ")\n",
        "\n",
        "n = len(out)\n",
        "for i in range(n):\n",
        "    data = out[i]\n",
        "    txt = data[\"generated_text\"]\n",
        "    print(f\"第{i+1}段：{txt}\")"
      ],
